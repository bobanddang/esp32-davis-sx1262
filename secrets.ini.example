; Copy to secrets.ini and fill in (secrets.ini is gitignored).
; This file replaces env build_flags — keep the ${flags*} line.

[env:esp32-s3-devkitc1-n16r8]
build_flags =
    ${flags.build_flags}
    -D WIFI_SSID=\"your-ssid\"
    -D WIFI_PASSWORD=\"your-password\"
    -D MQTT_HOST=\"192.168.1.10\"
    ; -D MQTT_PORT=1883
    ; -D MQTT_USER=\"\"
    ; -D MQTT_PASSWORD=\"\"
    ; -D DAVIS_STATION_ID=0

[env:esp32-c3-devkitm-1]
build_flags =
    ${flags_usb.build_flags}
    -D WIFI_SSID=\"your-ssid\"
    -D WIFI_PASSWORD=\"your-password\"
    -D MQTT_HOST=\"192.168.1.10\"

[env:esp32-c5-devkitc1-n4]
build_flags =
    ${flags_usb.build_flags}
    -D WIFI_SSID=\"your-ssid\"
    -D WIFI_PASSWORD=\"your-password\"
    -D MQTT_HOST=\"192.168.1.10\"
